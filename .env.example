# =============================================================================
# APLINKOS KINTAMIEJI - nukopijuokite šį failą į .env ir pakeiskite reikšmes
# =============================================================================
# Naudojimas:
#   cp .env.example .env
#   nano .env               # arba redaguokite mėgstamu redaktoriumi
#   docker-compose up -d

# --- Flask ---
# BŪTINAI pakeiskite šį raktą produkcijoje (galima sugeneruoti su:
#   python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=pakeisk-mane-i-atsitiktinius-32-simbolius

# --- PostgreSQL ---
# Slaptažodis DB vartotojui `mokykla` - saugokite konfidencialiai
DB_PASSWORD=slaptas123

# --- Neprivaloma ---
# DATABASE_URL - jei norite naudoti išorinę DB (pvz., Render.com Postgres),
# nurodykite pilną URL. Palikus tuščią - naudos vidinį docker-compose PG servisą.
# DATABASE_URL=postgresql://vartotojas:slaptas@host.example.com:5432/db_vardas
